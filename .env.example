# ---- Dhan feed account (the operator's) --------------------------------------------------
# In production the token is pushed daily through the admin API (PUT /admin/feed/token), never
# read from here. These two are only used for direct access: scripts/live_smoke.py and local
# development without the server.
DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=

# ---- Server -------------------------------------------------------------------------------
# Public base URL the AI host reaches (no trailing slash). The MCP endpoint is <PUBLIC_URL>/
# and the watchers page <PUBLIC_URL>/watchers. There is no authentication: keep the host internal.
SLASH_DHAN_MCP_PUBLIC_URL=http://127.0.0.1:8020
SLASH_DHAN_MCP_HOST=127.0.0.1
SLASH_DHAN_MCP_PORT=8020
# Random strings of at least 32 characters (letters, digits, - and _ only). ADMIN_SECRET is the
# bearer token of the admin API; changing CREDS_ENCRYPTION_KEY invalidates the stored feed token
# (push it again).
SLASH_DHAN_MCP_ADMIN_SECRET=
CREDS_ENCRYPTION_KEY=
# Operators who receive the feed-expired and expires-soon emails (comma separated).
SLASH_DHAN_MCP_OPERATOR_EMAILS=
# State: sqlite database, script workspace and instrument cache live here.
#SLASH_DHAN_MCP_STATE_DIR=~/.slash-dhan-mcp
#SLASH_DHAN_MCP_DB=<state dir>/slash-dhan-mcp.sqlite3

# Email for watcher alerts and operator notices (https://resend.com). Unset: mails are logged.
RESEND_API_KEY=
EMAIL_FROM=/markets <no-reply@example.com>

# Optional. PostHog product analytics (https://posthog.com): project API key (phc_...) and
# ingestion host. Unset: no events leave the box. Events are personless (the MCP has no user
# accounts) and carry tool outcomes, timings, Dhan endpoint counts and the script source; never
# the Dhan token, run tokens or alert emails.
POSTHOG_API_KEY=
#POSTHOG_HOST=https://us.i.posthog.com

# Optional. Shared secret for POST /internal/sweep (forced sweeps from outside the process).
SWEEP_SECRET=
# Optional tuning (defaults shown).
#SWEEP_INTERVAL_SECONDS=60
#SLASH_DHAN_MCP_FEED_WARNING_HOURS=2
#SCRIPT_TIMEOUT_SECONDS=60
#SCRIPT_MAX_TIMEOUT_SECONDS=180
# Cap applied when the caller is ChatGPT (its tool calls time out after about a minute).
#SCRIPT_TIMEOUT_OPENAI_SECONDS=50
#SCRIPT_MAX_OUTPUT_BYTES=65536
#MAX_CONCURRENT_RUNS=2
#SLASHDHAN_CALL_BUDGET=40
#WATCHERS_MAX_ARMED=50
#WATCHERS_MIN_GAP_MINUTES=15
#DHAN_BASE_URL=https://api.dhan.co/v2
#SLASHDHAN_SCRIP_MASTER_URL=https://images.dhan.co/api-data/api-scrip-master-detailed.csv
# Plugin Directory domain verification: the token OpenAI asks you to serve as plain text at
# <PUBLIC_URL>/.well-known/openai-apps-challenge.
#OPENAI_APPS_CHALLENGE_TOKEN=
# The SKILL.md served as <PUBLIC_URL>/slash-markets-dhan.zip (default: the repo root file).
#SLASH_DHAN_MCP_SKILL_FILE=
